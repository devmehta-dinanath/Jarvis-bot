# Docker-only (any Linux machine): ./scripts/docker-setup.sh then ./scripts/docker-up.sh
# Copy manually: cp .env.example .env

# SQLite main DB (default local: data/jarvis.db; Docker sets this in docker-compose.yml)
# DATABASE_URL=sqlite:////app/data/jarvis.db

PORT=8000
AUTO_START_SERVICES=true

SCREENPIPE_ENABLED=true
SCREENPIPE_API_TOKEN=sp-your-token-here
SCREENPIPE_API_URL=http://127.0.0.1:3030
SCREENPIPE_CLI_COMMAND=screenpipe record --use-system-default-audio
SCREENPIPE_START_CLI=true
SCREENPIPE_POLL_INTERVAL_SECONDS=2.0
SCREENPIPE_SYNC_OVERLAP_SECONDS=60
SCREENPIPE_SYNC_BATCH_LIMIT=100
# Screenpipe frame-diff (native installs); idle timer disabled so capture is change-driven
SCREENPIPE_VISUAL_CHECK_INTERVAL_MS=500
SCREENPIPE_MIN_CAPTURE_INTERVAL_MS=300
SCREENPIPE_VISUAL_CHANGE_THRESHOLD=0.005
SCREENPIPE_IDLE_CAPTURE_INTERVAL_MS=3600000
# Linux Docker: jarvis watches X11 pixels and captures on change (Screenpipe UI recorder is off)
X11_CHANGE_CAPTURE_ENABLED=auto
SCREENPIPE_SYNC_FRAMES=auto
SCREEN_CHANGE_CHECK_INTERVAL_SECONDS=0.4
SCREEN_CHANGE_MIN_CAPTURE_SECONDS=0.5

OCR_POLL_INTERVAL_SECONDS=0.5

ACTIVITY_POLL_INTERVAL_SECONDS=2.0
ACTIVITY_CHUNK_GAP_SECONDS=120

# ChromaDB vector store (semantic search on cleaned activity text)
CHROMA_ENABLED=true
CHROMA_PATH=data/chroma
CHROMA_COLLECTION_NAME=activity_chunks
CHROMA_LOG_EMBEDDINGS=true

# Storage: false = no per-frame .txt or activity .json on disk (SQLite + Chroma only)
SAVE_FRAME_OCR_FILES=false
SAVE_ACTIVITY_JSON_FILES=false
# Keep newest N frame JPGs on disk; when over limit, delete oldest batch (300 → purge 100 → 200 left)
DELETE_FRAME_IMAGES_AFTER_CHROMA_INDEX=true
FRAME_IMAGE_RETENTION_MAX=200
FRAME_IMAGE_RETENTION_PURGE=100

# Meeting audio transcripts (Screenpipe) + calendar highlights
MEETING_AUDIO_SYNC_ENABLED=true
MEETING_AUDIO_SEARCH_LIMIT=20
MEETING_HIGHLIGHT_DEFAULT_DURATION_MINUTES=30
CALENDAR_DEFAULT_TIMEZONE=UTC

# Google Calendar (OAuth client JSON from Google Cloud Console)
GOOGLE_CALENDAR_CREDENTIALS_PATH=data/google_calendar_credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=data/google_calendar_token.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:8000/api/v1/calendar/auth/callback
