# Docker-only (any Linux machine): ./scripts/docker-setup.sh then ./scripts/docker-up.sh
# Copy manually: cp .env.example .env

# SQLite main DB (default local: data/jarvis.db; Docker sets this in docker-compose.yml)
# DATABASE_URL=sqlite:////app/data/jarvis.db

PORT=8000
AUTO_START_SERVICES=true

SCREENPIPE_ENABLED=true
SCREENPIPE_API_TOKEN=sp-your-token-here
SCREENPIPE_API_URL=http://127.0.0.1:3030
SCREENPIPE_CLI_COMMAND=screenpipe record --audio-all
SCREENPIPE_START_CLI=true
SCREENPIPE_POLL_INTERVAL_SECONDS=2.0
SCREENPIPE_SYNC_OVERLAP_SECONDS=60
SCREENPIPE_SYNC_BATCH_LIMIT=100
# Screenpipe frame-diff (native installs); idle timer disabled so capture is change-driven
SCREENPIPE_VISUAL_CHECK_INTERVAL_MS=500
SCREENPIPE_MIN_CAPTURE_INTERVAL_MS=300
SCREENPIPE_VISUAL_CHANGE_THRESHOLD=0.005
SCREENPIPE_IDLE_CAPTURE_INTERVAL_MS=3600000
# Linux Docker: jarvis watches X11 pixels and captures on change (Screenpipe UI recorder is off)
X11_CHANGE_CAPTURE_ENABLED=auto
SCREENPIPE_SYNC_FRAMES=auto
SCREEN_CHANGE_CHECK_INTERVAL_SECONDS=0.4
SCREEN_CHANGE_MIN_CAPTURE_SECONDS=0.5

OCR_POLL_INTERVAL_SECONDS=0.5

ACTIVITY_POLL_INTERVAL_SECONDS=2.0
ACTIVITY_CHUNK_GAP_SECONDS=120

# ChromaDB vector store (semantic search on cleaned activity text)
CHROMA_ENABLED=true
CHROMA_PATH=data/chroma
CHROMA_COLLECTION_NAME=activity_chunks
CHROMA_LOG_EMBEDDINGS=true

# Storage: false = no per-frame .txt or activity .json on disk (SQLite + Chroma only)
SAVE_FRAME_OCR_FILES=false
SAVE_ACTIVITY_JSON_FILES=false
# Keep newest N frame JPGs on disk; when over limit, delete oldest batch (300 → purge 100 → 200 left)
DELETE_FRAME_IMAGES_AFTER_CHROMA_INDEX=true
FRAME_IMAGE_RETENTION_MAX=200
FRAME_IMAGE_RETENTION_PURGE=100

# Meeting audio transcripts (Screenpipe) + calendar highlights
MEETING_AUDIO_SYNC_ENABLED=true
MEETING_AUDIO_SEARCH_LIMIT=20
MEETING_AUDIO_SEARCH_PADDING_SECONDS=300
MEETING_TRANSCRIPT_SYNC_INTERVAL_SECONDS=30.0
MEETING_TRANSCRIPT_RETRY_MAX_AGE_HOURS=6
MEETING_HIGHLIGHT_DEFAULT_DURATION_MINUTES=30
CALENDAR_DEFAULT_TIMEZONE=UTC

# Google Calendar (OAuth client JSON from Google Cloud Console)
GOOGLE_CALENDAR_CREDENTIALS_PATH=data/google_calendar_credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=data/google_calendar_token.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:8000/api/v1/calendar/auth/callback

# OpenAI daily insights (OCR activity → today summary + tomorrow task/meeting predictions)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
SUMMARY_ENABLED=true
SUMMARY_POLL_INTERVAL_SECONDS=60
# 0 = include full OCR text per chunk (recommended). Set e.g. 150 to truncate long chunks.
SUMMARY_MAX_CHUNK_PREVIEW_CHARS=0
# Max OCR chars per OpenAI batch; day is split into multiple batches if needed (nothing dropped)
SUMMARY_MAX_INPUT_CHARS=8000
# 0 = unlimited batches per day (all OCR data included via multi-pass)
SUMMARY_MAX_BATCHES_PER_HOUR=0

# WhatsApp Cloud API (Meta) — webhook → chat history → AI classify → suggestions
WHATSAPP_ENABLED=true
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_BASE=https://graph.facebook.com
# From Meta App Dashboard → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-long-lived-access-token
# Any string you choose; must match the token entered in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
# App secret (Meta App → Settings → Basic) — used to verify X-Hub-Signature-256
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_POLL_INTERVAL_SECONDS=30
# How many recent messages to feed the classifier as conversation context
WHATSAPP_HISTORY_CONTEXT_LIMIT=8
# Max chars kept from each history message before sending context to OpenAI
WHATSAPP_CONTEXT_MESSAGE_MAX_CHARS=240
# false = use template-based reply drafts and avoid a second OpenAI call per suggestion
WHATSAPP_AI_DRAFTS_ENABLED=false
# Free-form replies allowed only within this many hours of the customer's last message
WHATSAPP_CUSTOMER_WINDOW_HOURS=24
# Default meeting length (minutes) when no end time is given in the conversation
WHATSAPP_DEFAULT_MEETING_MINUTES=60
# Default language code for template messages
WHATSAPP_TEMPLATE_DEFAULT_LANGUAGE=en_US
# Optional: Meta-approved template name for meeting confirmations outside the 24h window.
# Body should use {{1}} = meeting time, {{2}} = meet link.
# WHATSAPP_MEETING_CONFIRMATION_TEMPLATE=meeting_confirmed
# Auto-book Google Calendar when a proposed meeting slot is free (requires calendar OAuth)
WHATSAPP_AUTO_ADD_CALENDAR=false
# Boot only the WhatsApp worker (no screenpipe, OCR, activity, or summary workers)
WHATSAPP_ONLY_MODE=false
# How many recent "wrong" corrections to include in the classifier prompt
WHATSAPP_CORRECTIONS_CONTEXT_LIMIT=5
