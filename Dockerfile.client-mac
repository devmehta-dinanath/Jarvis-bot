# macOS hybrid client — OCR + sync API only. Screenpipe runs natively on the Mac host.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH="/opt/venv/bin:${PATH}"

WORKDIR /app

COPY requirements-client.txt .

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl \
        python3.12 python3.12-venv python3.12-dev \
        ffmpeg \
        libgomp1 libglib2.0-0 libsm6 libxext6 libxrender1 libgl1 \
    && python3.12 -m venv /opt/venv \
    && ln -sf python3.12 /opt/venv/bin/python \
    && ln -sf python3.12 /opt/venv/bin/python3 \
    && /opt/venv/bin/python -m ensurepip --upgrade \
    && /opt/venv/bin/python -m pip install --upgrade pip setuptools wheel \
    && /opt/venv/bin/python -m pip install paddlepaddle==2.6.2 \
    && /opt/venv/bin/python -m pip install -r requirements-client.txt \
    && rm -rf /var/lib/apt/lists/*

COPY app ./app
COPY scripts/docker-mac-client-entrypoint.sh /usr/local/bin/docker-mac-client-entrypoint.sh

RUN mkdir -p /app/data /app/media \
    && chmod +x /usr/local/bin/docker-mac-client-entrypoint.sh

ENV RUNNING_IN_DOCKER=true \
    APP_ROLE=client \
    SCREENPIPE_START_CLI=false

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD curl -f http://127.0.0.1:8000/health || exit 1

ENTRYPOINT ["docker-mac-client-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
