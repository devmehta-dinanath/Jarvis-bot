
APP_ROLE=client
PORT=8000
AUTO_START_SERVICES=true
RUNNING_IN_DOCKER=true
WHATSAPP_ONLY_MODE=false

# Local buffer only — not the central database
DATABASE_URL=sqlite:////app/data/client-buffer.db

# Central server — must match SYNC_API_KEY in server .env
JARVIS_SERVER_URL=https://jarvis-api.lilium.co.in
SYNC_API_KEY=b5967ac012fe968bc12b70f31d7d17be1d5912f9fb9e76bf97819ff0c8d6366b
SYNC_ENABLED=true
SYNC_POLL_INTERVAL_SECONDS=5.0

# Screenpipe capture (screen + mic + system audio)
SCREENPIPE_ENABLED=true
# SCREENPIPE_API_TOKEN — auto-fetched on first container start (docker-entrypoint.sh)
# and saved to ~/.screenpipe/.env; optional to set manually here.
SCREENPIPE_API_URL=http://127.0.0.1:3030
SCREENPIPE_CLI_COMMAND=screenpipe record
SCREENPIPE_START_CLI=true
SCREENPIPE_POLL_INTERVAL_SECONDS=2.0
SCREENPIPE_SYNC_OVERLAP_SECONDS=60
SCREENPIPE_SYNC_BATCH_LIMIT=100
# Linux Docker: X11 pixel watcher captures on screen change
X11_CHANGE_CAPTURE_ENABLED=auto
SCREENPIPE_SYNC_FRAMES=auto
SCREEN_CHANGE_CHECK_INTERVAL_SECONDS=0.4
SCREEN_CHANGE_MIN_CAPTURE_SECONDS=0.5
PIPELINE_VERBOSE_LOGS=true
SCREENPIPE_LOG_CLI_VERBOSE=true

OCR_POLL_INTERVAL_SECONDS=0.5
ACTIVITY_POLL_INTERVAL_SECONDS=2.0
ACTIVITY_CHUNK_GAP_SECONDS=120

# Chroma + server integrations run on server only
CHROMA_ENABLED=false
SUMMARY_ENABLED=false
WHATSAPP_ENABLED=false

# Meeting audio transcripts (Screenpipe) — uploaded to server with activity sync
MEETING_AUDIO_SYNC_ENABLED=true
MEETING_AUDIO_SEARCH_LIMIT=20
MEETING_TRANSCRIPT_SYNC_INTERVAL_SECONDS=30.0
MEETING_HIGHLIGHT_DEFAULT_DURATION_MINUTES=30
CALENDAR_DEFAULT_TIMEZONE=Asia/Kolkata

# Local frame storage (cleaned text syncs to server; JPGs optional on disk)
SAVE_FRAME_OCR_FILES=false
SAVE_ACTIVITY_JSON_FILES=false
DELETE_FRAME_IMAGES_AFTER_CHROMA_INDEX=true
FRAME_IMAGE_RETENTION_MAX=200
FRAME_IMAGE_RETENTION_PURGE=100
