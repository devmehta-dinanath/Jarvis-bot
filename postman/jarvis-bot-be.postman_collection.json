    {
      "name": "6. Activity Summaries (OpenAI OCR)",
      "item": [
        {
          "name": "Summary Stats (tokens)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/summaries/stats",
            "description": "OpenAI summary worker status and today's token counts. Requires OPENAI_API_KEY in server .env."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "console.log('=== SUMMARY STATS ===');",
                  "console.log('enabled:', j.enabled);",
                  "console.log('worker_running:', j.worker_running);",
                  "console.log('model:', j.model);",
                  "console.log('tokens in/out:', j.daily_prompt_tokens, '/', j.daily_completion_tokens);",
                  "console.log('tokens_date:', j.tokens_date);",
                  "console.log('last_seen_date:', j.last_seen_date);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Hourly Summaries — by date",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/summaries?period_type=hourly&date={{summary_date}}&limit=50",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "summaries"],
              "query": [
                { "key": "period_type", "value": "hourly" },
                { "key": "date", "value": "{{summary_date}}" },
                { "key": "limit", "value": "50" }
              ]
            },
            "description": "Hourly summaries for a local calendar day (CALENDAR_DEFAULT_TIMEZONE). Set summary_date collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "console.log('hourly summaries total:', j.total);",
                  "j.items.forEach(s => console.log(",
                  "  `${s.status} ${s.period_start} → ${s.period_end} | chunks=${s.chunk_count} | ${s.summary_text.slice(0, 120)}…`",
                  "));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Daily Summaries — by date",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/summaries?period_type=daily&date={{summary_date}}&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "summaries"],
              "query": [
                { "key": "period_type", "value": "daily" },
                { "key": "date", "value": "{{summary_date}}" },
                { "key": "limit", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
