                  "console.log('TOTAL chunks in SQLite:', j.total);",
                  "console.log('returned items:', j.items.length);",
                  "if (j.items.length) {",
                  "  pm.collectionVariables.set('chunk_id', String(j.items[0].id));",
                  "  j.items.forEach(c => console.log(`chunk ${c.id} category=${c.category} frames=${c.frame_count} chars=${(c.cleaned_text||'').length}`));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
