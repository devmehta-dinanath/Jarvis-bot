{
  "info": {
    "_postman_id": "jarvis-bot-be-verify-db",
    "name": "Jarvis Bot BE — DB Verification",
    "description": "Verify SQLite + Chroma data: totals, OCR per frame, last N frames, chunks, embeddings, and OpenAI activity summaries.\n\n**Setup:** Import → set `base_url` (http://127.0.0.1:8000) and `recording_id` (usually 1). Set `OPENAI_API_KEY` in server `.env` for summaries.\n\n**Start here:** folder **0. Pipeline Dashboard** → `Pipeline Stats (all)` or `Recording Stats (last 5 frames)`.\n\n**Summaries:** folder **6. Activity Summaries** — requires `OPENAI_API_KEY` + activity chunks with OCR text.\n\nOpen Postman Console (View → Show Postman Console) to see printed totals.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "recording_id",
      "value": "1"
    },
    {
      "key": "chunk_id",
      "value": "1"
    },
    {
      "key": "category",
      "value": "code"
    },
    {
      "key": "search_query",
      "value": "terminal docker"
    },
    {
      "key": "summary_date",
      "value": "2026-06-11"
    }
  ],
  "item": [
    {
      "name": "0. Pipeline Dashboard (START HERE)",
      "item": [
        {
          "name": "Pipeline Stats — ALL totals + last 5 frames each",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/pipeline/stats?recent_frames=5",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "pipeline", "stats"],
              "query": [{ "key": "recent_frames", "value": "5" }]
            },
            "description": "One call: total frames, OCR counts, activity chunks by category, Chroma embedding count, and last 5 frames with paddle/screenpipe OCR previews per recording."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "console.log('=== PIPELINE DASHBOARD ===');",
                  "console.log('database:', j.database);",
                  "console.log('chroma_embeddings:', j.chroma_embeddings);",
                  "console.log('chroma_path:', j.chroma_path);",
                  "(j.recordings || []).forEach(r => {",
                  "  console.log(`\\n--- recording ${r.recording_id}: ${r.title} ---`);",
                  "  console.log('total_frames:', r.total_frames);",
                  "  console.log('ocr_done:', r.ocr_done, '| queued:', r.ocr_queued, '| failed:', r.ocr_failed);",
                  "  console.log('activity_processed:', r.activity_processed, '| pending:', r.activity_pending);",
                  "  console.log('images_on_disk:', r.images_on_disk);",
                  "  console.log('activity_chunks_total:', r.activity_chunks_total);",
                  "  (r.activity_chunks_by_category || []).forEach(c => console.log(`  category ${c.category}: ${c.count}`));",
                  "  console.log('recent_frames:');",
                  "  (r.recent_frames || []).forEach(f => console.log(",
                  "    `  frame ${f.frame_index} id=${f.id} ocr=${f.ocr_status} paddle=${f.paddle_chars} screenpipe=${f.screenpipe_chars} img=${f.image_on_disk}`",
                  "  ));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Recording Stats — last 5 frames + OCR text",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/recordings/{{recording_id}}/pipeline/stats?recent_frames=5",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "recordings", "{{recording_id}}", "pipeline", "stats"],
              "query": [{ "key": "recent_frames", "value": "5" }]
            },
            "description": "Per-recording dashboard. Change recent_frames=10 for last 10 frames. Each frame includes paddle_preview and screenpipe_preview (first 200 chars)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "console.log('total_frames:', r.total_frames);",
                  "console.log('ocr_done:', r.ocr_done, '/', r.total_frames);",
                  "console.log('chunks:', r.activity_chunks_total, '| chroma:', r.chroma_embeddings);",
                  "(r.recent_frames || []).forEach(f => {",
                  "  console.log(`\\nFrame ${f.frame_index} (id=${f.id})`);",
                  "  console.log('  app:', f.app_name, '| ocr:', f.ocr_status, '| activity:', f.activity_status);",
                  "  console.log('  paddle_chars:', f.paddle_chars, '| screenpipe_chars:', f.screenpipe_chars);",
                  "  console.log('  paddle:', f.paddle_preview);",
                  "  console.log('  screenpipe:', f.screenpipe_preview);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Recording Stats — last 10 frames",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/recordings/{{recording_id}}/pipeline/stats?recent_frames=10",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "recordings", "{{recording_id}}", "pipeline", "stats"],
              "query": [{ "key": "recent_frames", "value": "10" }]
            }
          }
        }
      ]
    },
    {
      "name": "1. Health & Services",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('API is up', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "console.log('status:', j.status);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Services Status (capture, OCR, vector count)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/services/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "console.log('screenpipe running:', j.screenpipe?.running);",
                  "console.log('OCR running:', j.paddle_ocr?.running);",
                  "console.log('activity running:', j.activity?.running);",
                  "console.log('summary enabled:', j.summary?.enabled);",
                  "console.log('summary worker:', j.summary?.worker_running);",
                  "console.log('summary tokens today:', j.summary?.daily_prompt_tokens, '/', j.summary?.daily_completion_tokens);",
                  "console.log('Chroma embeddings count:', j.vector?.count);",
                  "console.log('hint:', j.hint);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Recordings (SQLite)",
      "item": [
        {
          "name": "List All Recordings",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/recordings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json();",
                  "console.log('recordings count:', rows.length);",
                  "rows.forEach(r => console.log(",
                  "  `id=${r.id} total_frames=${r.total_frames} ocr_done=${r.ocr_completed_frames} processed=${r.processed_frames} status=${r.status}`",
                  "));",
                  "if (rows.length) pm.collectionVariables.set('recording_id', String(rows[0].id));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Recording Detail (+ all frames)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/recordings/{{recording_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "console.log('recording_id:', r.id);",
                  "console.log('total_frames:', r.total_frames);",
                  "console.log('ocr_completed_frames:', r.ocr_completed_frames);",
                  "console.log('processed_frames:', r.processed_frames);",
                  "console.log('frames in response:', (r.frames || []).length);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Frames & OCR Text (SQLite)",
      "item": [
        {
          "name": "List Frames for Recording",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/recordings/{{recording_id}}/frames"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const frames = pm.response.json();",
                  "const done = frames.filter(f => f.ocr_status === 'done');",
                  "const withPaddle = frames.filter(f => f.ocr_text && f.ocr_text.length > 0);",
                  "const withScreenpipe = frames.filter(f => f.screenpipe_ocr_text && f.screenpipe_ocr_text.length > 0);",
                  "const processed = frames.filter(f => f.activity_status === 'processed');",
                  "console.log('total frames:', frames.length);",
                  "console.log('ocr done:', done.length);",
                  "console.log('with paddle ocr_text:', withPaddle.length);",
                  "console.log('with screenpipe ocr_text:', withScreenpipe.length);",
                  "console.log('activity processed:', processed.length);",
                  "if (frames.length) {",
                  "  const last = frames[frames.length - 1];",
                  "  pm.collectionVariables.set('frame_id', String(last.id));",
                  "  console.log('latest frame:', last.id, 'index', last.frame_index);",
                  "  console.log('paddle chars:', (last.ocr_text || '').length);",
                  "  console.log('screenpipe chars:', (last.screenpipe_ocr_text || '').length);",
                  "  console.log('paddle preview:', (last.ocr_text || '').slice(0, 120));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Latest Frame OCR (from recording detail)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/recordings/{{recording_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "recordings", "{{recording_id}}"]
            },
            "description": "Open response → frames[] → check ocr_text, screenpipe_ocr_text, ocr_status, activity_status per frame."
          }
        }
      ]
    },
    {
      "name": "4. Activity Chunks (SQLite)",
      "item": [
        {
          "name": "List Chunks — total count",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
