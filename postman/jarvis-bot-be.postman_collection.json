              }
            }
          ]
        },
        {
          "name": "List Chunks — recording + category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/recordings/{{recording_id}}/activity/chunks?category={{category}}&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "recordings", "{{recording_id}}", "activity", "chunks"],
              "query": [
                { "key": "category", "value": "{{category}}" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Single Chunk (full cleaned_text)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/activity/chunks/{{chunk_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const c = pm.response.json();",
                  "console.log('chunk_id:', c.id);",
                  "console.log('category:', c.category);",
                  "console.log('app:', c.app_name);",
                  "console.log('frame_count:', c.frame_count);",
                  "console.log('frame_ids:', c.frame_ids);",
                  "console.log('cleaned_text chars:', (c.cleaned_text || '').length);",
                  "console.log('preview:', (c.cleaned_text || '').slice(0, 200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
