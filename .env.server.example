APP_ROLE=server
PORT=8000
AUTO_START_SERVICES=true
RUNNING_IN_DOCKER=true
WHATSAPP_ONLY_MODE=false

DATABASE_URL=sqlite:////app/data/jarvis.db

# Shared secret — desktop clients must use the exact same key
SYNC_API_KEY=b5967ac012fe968bc12b70f31d7d17be1d5912f9fb9e76bf97819ff0c8d6366b

# Capture disabled on server (runs on desktop clients only)
SCREENPIPE_ENABLED=false
SCREENPIPE_START_CLI=false

# ChromaDB vector search (synced activity from clients)
CHROMA_ENABLED=true
CHROMA_PATH=data/chroma
CHROMA_COLLECTION_NAME=activity_chunks
CHROMA_LOG_EMBEDDINGS=true

# Storage retention for synced frame images
SAVE_FRAME_OCR_FILES=false
SAVE_ACTIVITY_JSON_FILES=false
DELETE_FRAME_IMAGES_AFTER_CHROMA_INDEX=true
FRAME_IMAGE_RETENTION_MAX=200
FRAME_IMAGE_RETENTION_PURGE=100

# Meeting / calendar defaults
MEETING_AUDIO_SYNC_ENABLED=true
MEETING_AUDIO_SEARCH_LIMIT=20
MEETING_HIGHLIGHT_DEFAULT_DURATION_MINUTES=30
CALENDAR_DEFAULT_TIMEZONE=Asia/Kolkata

# OpenAI daily insights
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4o-mini
SUMMARY_ENABLED=true
SUMMARY_POLL_INTERVAL_SECONDS=60
SUMMARY_PERIOD_MINUTES=30
# 0 = include full OCR text per chunk (recommended)
SUMMARY_MAX_CHUNK_PREVIEW_CHARS=0
SUMMARY_MAX_INPUT_CHARS=8000
# 0 = unlimited batches per day
SUMMARY_MAX_BATCHES_PER_HOUR=0

# Google Calendar — redirect URI must match your public server URL
GOOGLE_CALENDAR_CREDENTIALS_PATH=data/google_calendar_credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=data/google_calendar_token.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_REDIRECT_URI=https://jarvis-api.lilium.co.in/api/v1/calendar/auth/callback

# WhatsApp Cloud API (Meta) — all fields below marked REQUIRED must be set for WhatsApp to work.
