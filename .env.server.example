# Server deployment: ./scripts/server-deploy.sh
# Central DB, WhatsApp, Google Calendar, AI summaries, sync ingestion API.

APP_ROLE=server
PORT=8000
AUTO_START_SERVICES=true
RUNNING_IN_DOCKER=true

DATABASE_URL=sqlite:////app/data/jarvis.db

# Shared secret — desktop clients must use the same key
SYNC_API_KEY=change-me-to-a-long-random-string

# Capture disabled on server
SCREENPIPE_ENABLED=false
SCREENPIPE_START_CLI=false

CHROMA_ENABLED=true
CHROMA_PATH=data/chroma
CHROMA_COLLECTION_NAME=activity_chunks

SUMMARY_ENABLED=true
WHATSAPP_ENABLED=true

# OpenAI daily insights
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
SUMMARY_POLL_INTERVAL_SECONDS=60
# Token savers — compress OCR before OpenAI (recommended for production)
SUMMARY_MAX_CHUNK_PREVIEW_CHARS=300
SUMMARY_MAX_INPUT_CHARS=8000
CALENDAR_DEFAULT_TIMEZONE=UTC

# Google Calendar — set redirect URI to your server's public URL
GOOGLE_CALENDAR_CREDENTIALS_PATH=data/google_calendar_credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=data/google_calendar_token.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_REDIRECT_URI=http://YOUR_SERVER_IP:8000/api/v1/calendar/auth/callback

# WhatsApp Cloud API (Meta)
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-long-lived-access-token
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
# App ID + secret enable automatic token refresh before expiry (saved to data/whatsapp_access_token.json)
WHATSAPP_APP_ID=your-meta-app-id
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_POLL_INTERVAL_SECONDS=30
